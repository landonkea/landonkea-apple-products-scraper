# ───────────────────────────────────────────────────────────────────
# .gitignore — files that should NEVER be committed
# ───────────────────────────────────────────────────────────────────

# ── Python bytecode ────────────────────────────────────────────
__pycache__/
*.py[cod]
*.so

# ── Virtual environments ──────────────────────────────────────
.venv/
venv/
env/

# ── IDE files ─────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── OS files ──────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Project-specific ──────────────────────────────────────────
# Database file (created at runtime, kept in git for continuity)
# Comment these out if you want the DB tracked in git:
# data/listings.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# Local "dev" runs are always ephemeral/local-only (see
# src/environment.py) — never meant to be committed by a developer.
# The staging environment's DB (data/listings.staging.db) is the
# opposite: the scrape-staging.yml workflow explicitly commits it on
# purpose, the same way production commits data/listings.db, so it's
# NOT ignored here.
data/listings.dev.db

# ── Environment variables (local testing) ─────────────────────
# Create a .env file for local testing with your secrets.
# NEVER commit tokens or passwords.
.env
*.env.local

# ── Distribution builds ───────────────────────────────────────
dist/
build/
*.egg-info/

# ── Test artifacts ────────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/

# ── Agent instructions — never commit ─────────────────────────
AGENTS.md
PROJECT_CHECKLIST.md
