# ───────────────────────────────────────────────────────────────────
# Environment variables — production
# ───────────────────────────────────────────────────────────────────
# What .github/workflows/scrape.yml sets as repo secrets on the daily
# 13 UTC cron run against `main`. Documentation, not something to
# copy into a local .env, production runs only in GitHub Actions and
# posts to the real Discord channel and the real data/listings.db.
#
# If you're setting up this repo for the first time, add these as
# repository secrets under Settings -> Secrets and variables ->
# Actions, matching the names below exactly (scrape.yml references
# them as ${{ secrets.NAME }}).
# ───────────────────────────────────────────────────────────────────

ALERT_EMAIL_FROM=your-email@gmail.com
ALERT_EMAIL_TO=your-phone-number@vtext.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# The real deals channel. DISCORD_WEBHOOK_URL_DEV is never read in
# production, see src/notifier.py's is_production() gating.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/{webhook.id}/{webhook.token}

ENVIRONMENT=production
