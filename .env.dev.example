# ───────────────────────────────────────────────────────────────────
# Environment variables — dev
# ───────────────────────────────────────────────────────────────────
# Copy this to .env for local runs. dev is the only environment that
# never runs in GitHub Actions (see the Environments table in
# README.md), so most of these can stay blank. ENVIRONMENT=dev is
# the line that actually matters here: it points the scraper at
# data/listings.dev.db, and with no DISCORD_WEBHOOK_URL_DEV set, the
# notifier just logs what it would have sent instead of posting
# anywhere. See .env.example for the full variable list.
# ───────────────────────────────────────────────────────────────────

# ── Email alert settings (optional) ─────────────────────────────────
# Only needed if you want to see a real email alert while testing
# locally. Leave blank and the notifier logs instead of sending.
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
GMAIL_APP_PASSWORD=

# ── Discord alert settings ───────────────────────────────────────────
# Point this at a throwaway/testing channel if you want to see alerts
# fire while developing. Never put the real production webhook here.
DISCORD_WEBHOOK_URL_DEV=

# Leave this blank locally. dev never reads it (src/notifier.py only
# checks DISCORD_WEBHOOK_URL when ENVIRONMENT=production).
DISCORD_WEBHOOK_URL=

# ── Environment ───────────────────────────────────────────────────────
ENVIRONMENT=dev
