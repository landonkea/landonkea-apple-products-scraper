# ───────────────────────────────────────────────────────────────────
# Environment variables for landonkea-apple-products-scraper
# ───────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file (it's in .gitignore).
#
# These correspond to environment secrets in GitHub Actions.
# ───────────────────────────────────────────────────────────────────

# ── Email alert settings ──────────────────────────────────────────
# The FROM address — who the alert email appears to come from.
ALERT_EMAIL_FROM=your-email@gmail.com

# The TO address — who receives the alert.
ALERT_EMAIL_TO=your-phone-number@vtext.com

# Gmail App Password (NOT your regular password).
# Generate one at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your-16-char-app-password

# ── Discord alert settings ───────────────────────────────────────
# Webhook URL from your Discord server's "Integrations" settings.
# Format: https://discord.com/api/webhooks/{webhook.id}/{webhook.token}
DISCORD_WEBHOOK_URL=

# Optional separate webhook for local dev/staging test runs, so
# testing never posts to the real production Discord channel above.
# If unset while ENVIRONMENT is dev/staging, the notifier just logs
# what it would have sent instead of posting anywhere.
DISCORD_WEBHOOK_URL_DEV=

# Separate webhook for the ebike search only (see config.yaml's ebike
# searches: entry and src/notifier.py's _resolve_discord_webhook_url())
# , so its alerts land in a different channel from the Apple deal
# alerts above. Optional — unset means those alerts are just skipped
# with a log line, not an error.
DISCORD_WEBHOOK_URL_EBIKE=

# Non-production counterpart to DISCORD_WEBHOOK_URL_EBIKE, same
# purpose as DISCORD_WEBHOOK_URL_DEV above but for the ebike search.
DISCORD_WEBHOOK_URL_EBIKE_DEV=

# ── Environment ────────────────────────────────────────────────────
# One of: dev, staging, production. Defaults to "production" if
# unset (see src/environment.py for why). Always set this to "dev"
# when running locally so you don't touch the production database
# or Discord channel.
ENVIRONMENT=dev
