# ───────────────────────────────────────────────────────────────────
# Environment variables — staging
# ───────────────────────────────────────────────────────────────────
# This documents the repo secrets .github/workflows/scrape-staging.yml
# reads when it runs against the `staging` branch, it isn't something
# you'd normally copy to a local .env, staging only ever runs in
# GitHub Actions.
#
# Staging reuses the real email credentials on purpose (a price-drop
# alert during a staging test run is still worth seeing by email),
# but swaps DISCORD_WEBHOOK_URL for DISCORD_WEBHOOK_URL_DEV so a
# broken scraper change under test can never post to the real deals
# channel. See scrape-staging.yml's header comment for the full
# reasoning and src/notifier.py for the is_production() gating.
# ───────────────────────────────────────────────────────────────────

ALERT_EMAIL_FROM=your-email@gmail.com
ALERT_EMAIL_TO=your-phone-number@vtext.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Throwaway/testing Discord channel, not the real one.
DISCORD_WEBHOOK_URL_DEV=

# Deliberately not set here. Staging never reads DISCORD_WEBHOOK_URL.
DISCORD_WEBHOOK_URL=

ENVIRONMENT=staging
